desc "Semibatch pyslimmc API fixture"
param kmc_volume 1.0e-17
param init_volume 0.1
param temperature 298.15
param t_end 0.4
param max_steps 1000
param seed 1301
param output_dir "feedh_results"
param mass_model repeat_units
monomer M 0.1 100.0
species Q 0.1
species R 0.0
feed F M 1.0
feed F Q 0.2
rate k const 0.0
rxn Q -> R k
at 0.05 feed F 1 mL
at 0.1 set_c Q 0.20
at 0.1 save
at 0.2 add_c Q 0.10
at 0.2 save
at 0.3 add_c Q -0.05
at 0.3 save
at 0.1 set_c M 0.20
at 0.2 add_c M 0.10
at 0.3 add_c M -0.05
