# Compact end-to-end fixture for CLI -> homo -> Storage -> pyslimmc.
desc "integration homo"
param output_dir "result"
param kmc_volume 1.0e-17
param init_volume 0.050
param temperature 343.15
param t_end 0.60
param max_steps 400000
param seed 7101
param mass_model repeat_units

monomer M 0.050 100.0
species R 2.0e-5
endgroup R 68.0
endgroup ACTIVE 0.0
endgroup H 1.0
polymer P active
polymer D dead
feed MFEED M 0.20

rate ki const 2.0e6
rate kp const 2.0e5
rate ktd const 2.0e7
macro init R + M -> P ki
macro prop P + M -> P kp
macro term_d P + P -> D + D ktd

at 0.20 feed MFEED 1 mL
at 0.30 set_temp 353.15
from 0.05 repeat 12 every 0.05 save
from 0.10 repeat 6 every 0.10 save_chains
