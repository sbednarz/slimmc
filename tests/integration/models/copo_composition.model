desc "integration composition-only storage"
param output_dir "result"
param kmc_volume 2.0e-17
param t_end 0.20
param max_steps 300000
param seed 7214
param sequence_mode composition

monomer A 0.03 100.0
monomer B 0.03 128.0
species R 2.0e-5
polymer PA active
polymer PB active
polymer D dead
rate ki 2.0e6
rate kp 4.0e5
macro init R + A -> PA ki
macro init R + B -> PB ki
macro prop PA + A -> PA kp
macro prop PA + B -> PB kp
macro prop PB + A -> PA kp
macro prop PB + B -> PB kp
every 0.04 save
every 0.10 save_chains
