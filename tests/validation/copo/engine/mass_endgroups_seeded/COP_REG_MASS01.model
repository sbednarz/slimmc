desc "copo seeded end-group mass validation"
param kmc_volume 1.0e-17
param t_end 0.3
param max_steps 15000
param seed 106
param sequence_mode full
param mass_model with_end_groups
monomer A 0.015 100.0
monomer B 0.015 128.0
species R 2.0e-5
endgroup R 68.0
endgroup ACTIVE 0.0
polymer PA active
polymer PB active
polymer D dead
endgroup H 1.0
endgroup U 0.0
rate ki 2.0e6
rate kp 4.0e5
rate ktd 1.0e6
macro init R + A -> PA ki
macro init R + B -> PB ki
macro prop PA + A -> PA kp
macro prop PA + B -> PB kp
macro prop PB + A -> PA kp
macro prop PB + B -> PB kp
macro term_d PA + PA -> D + D ktd
macro term_d PA + PB -> D + D ktd
macro term_d PB + PB -> D + D ktd
every 0.1 save
every 0.15 save_chains
