desc "EQ01 homo initiation"
param kmc_volume 1.0e-17
param t_end 0.08
param max_steps 200000
param seed 9301
param mass_model repeat_units
monomer M 0.020 100.0
species R 2.0e-5
endgroup R 68.0
endgroup ACTIVE 0.0
polymer P active
polymer D dead
rate ki const 1.0e8
macro init R + M -> P ki
at 0.08 save
at 0.08 save_chains
