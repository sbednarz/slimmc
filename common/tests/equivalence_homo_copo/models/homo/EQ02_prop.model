desc "EQ02 homo initiation and propagation"
param kmc_volume 1.0e-17
param t_end 0.10
param max_steps 300000
param seed 9302
param mass_model repeat_units
monomer M 0.020 100.0
species R 2.0e-5
endgroup R 68.0
endgroup ACTIVE 0.0
polymer P active
polymer D dead
rate ki const 1.0e8
rate kp const 2.0e5
macro init R + M -> P ki
macro prop P + M -> P kp
at 0.10 save
at 0.10 save_chains
