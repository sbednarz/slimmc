desc "EQ03 copo effective one-monomer build then depropagate"
param kmc_volume 1.0e-17
param t_end 0.20
param max_steps 400000
param seed 9303
param sequence_mode full
param mass_model repeat_units
monomer A 0.020 100.0
monomer B 0.0 128.0
species R 2.0e-5
endgroup R 68.0
endgroup ACTIVE 0.0
polymer PA active
polymer PAA active
polymer D dead
rate ki const 1.0e8
rate kp const 2.0e5
rate kd const 0.0
macro init R + A -> PA ki
macro prop PA + A -> PAA kp
macro prop PAA + A -> PAA kp
macro deprop PAA -> PAA + A kd
at 0.10 set_k ki 0.0
at 0.10 set_k kp 0.0
at 0.10 set_k kd 20.0
at 0.10 save
at 0.10 save_chains
at 0.20 save
at 0.20 save_chains
