desc "EQ01 copo effective one-monomer initiation"
param kmc_volume 1.0e-17
param t_end 0.08
param max_steps 200000
param seed 9301
param sequence_mode full
param mass_model repeat_units
monomer A 0.020 100.0
monomer B 0.0 128.0
species R 2.0e-5
endgroup R 68.0
endgroup ACTIVE 0.0
polymer PA active
polymer PAA active
polymer D dead
rate ki const 1.0e8
macro init R + A -> PA ki
at 0.08 save
at 0.08 save_chains
