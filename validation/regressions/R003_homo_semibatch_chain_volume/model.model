desc "R003 homo semibatch snapshot chain volume"
param output_dir "results/main"
param kmc_volume 1.0e-17
param init_volume 0.10
param t_end 1.0
param seed 9003
param mass_model repeat_units
monomer M 0.20 100
species R 2e-5
polymer P active
polymer D dead
feed MFEED M 0.50
rate ki const 2e6
rate kp const 2e5
rate ktc const 1e6
macro init R + M -> P ki
macro prop P + M -> P kp
macro term_c P + P -> D ktc
at 0.30 feed MFEED 0.02 mL
every 0.10 save
every 0.20 save_chains
