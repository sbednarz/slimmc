desc "C22 copo state snapshots more frequent than chain snapshots"
param kmc_volume 1.0e-17
param t_end 0.50
param max_steps 500000
param seed 3503
param sequence_mode full
param mass_model repeat_units
monomer A 0.030 100.0
monomer B 0.020 128.0
species R 2.0e-5
endgroup R 68.0
endgroup ACTIVE 0.0
polymer PA active
polymer PB active
polymer D dead
rate ki 1.0e8
rate kp 1.0e5
macro init R + A -> PA ki
macro init R + B -> PB ki
macro prop PA + A -> PA kp
macro prop PA + B -> PB kp
macro prop PB + A -> PA kp
macro prop PB + B -> PB kp
every 0.10 save
at 0.30 save_chains
