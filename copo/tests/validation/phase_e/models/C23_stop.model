desc "C23 copo clean completion by when stop"
param kmc_volume 1.0e-17
param t_end 10.0
param max_steps 1000000
param seed 3506
param sequence_mode full
param mass_model repeat_units
param when_check_events 1
monomer A 0.012 100.0
monomer B 0.008 128.0
species R 2.0e-5
polymer PA active
polymer PB active
polymer D dead
rate ki 1.0e8
rate kp 1.0e5
macro init R + A -> PA ki
macro init R + B -> PB ki
macro prop PA + A -> PA kp
macro prop PA + B -> PB kp
macro prop PB + A -> PA kp
macro prop PB + B -> PB kp
when X A > 0.02 stop
every 0.05 save
