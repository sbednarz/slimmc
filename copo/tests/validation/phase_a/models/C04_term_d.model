desc "C04 copo black-box disproportionation termination"
param kmc_volume 1.0e-17
param t_end .12
param max_steps 500000
param seed 5104
param sequence_mode full
param mass_model repeat_units
monomer A .025 100.0
monomer B .025 128.0
species R 3.0e-5
polymer PA active
polymer PB active
polymer D dead
rate ki const 1.0e9
rate kp const 2.0e5
rate kt const 0.0
macro init R + A -> PA ki
macro init R + B -> PB ki
macro prop PA + A -> PA kp
macro prop PA + B -> PB kp
macro prop PB + A -> PA kp
macro prop PB + B -> PB kp
macro term_d PA + PA -> D kt
macro term_d PA + PB -> D kt
macro term_d PB + PB -> D kt
at 0.05 set_k ki 0.0
at 0.05 set_k kp 0.0
at 0.05 set_k kt 2.0e8
at 0.05 save
at 0.05 save_chains
at 0.12 save
at 0.12 save_chains
