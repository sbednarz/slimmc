desc "C02 copo black-box terminal propagation"
param kmc_volume 1.0e-17
param t_end .12
param max_steps 500000
param seed 5102
param sequence_mode full
param mass_model repeat_units
monomer A .030 100.0
monomer B .030 128.0
species R 2.0e-5
polymer PA active
polymer PB active
polymer D dead
rate ki const 1.0e9
rate kp const 2.0e5
macro init R + A -> PA ki
macro init R + B -> PB ki
macro prop PA + A -> PA kp
macro prop PA + B -> PB kp
macro prop PB + A -> PA kp
macro prop PB + B -> PB kp
at 0.04 set_k ki 0.0
at 0.04 save
at 0.04 save_chains
at 0.12 save
at 0.12 save_chains
