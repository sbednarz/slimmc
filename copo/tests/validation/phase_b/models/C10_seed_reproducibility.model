desc "C10 copo validation: deterministic repeatability for a fixed seed"
param kmc_volume 1.0e-17
param t_end 100.0
param max_steps 3000
param seed 4202
param sequence_mode full
param mass_model repeat_units
monomer A 0.0 100.0
monomer B 0.0 128.0
species Q 0.010
species X 0.0
species Y 0.0
polymer PA active
polymer PB active
polymer D dead
rate k1 const 80.0
rate k2 const 220.0
rxn Q -> X k1
rxn Q -> Y k2
every 10.0 save
