desc "seeded homopolymer regression: exercises all macro channel kinds"
param kmc_volume 1.0e-17
param t_end 4.0
param max_steps 300000
param seed 4242
param mass_model with_end_groups

monomer M 1.0 100.12
species I 1.0e-4
species R 0.0
species CTA 4.0e-4
species Rcta 0.0
species CAP 2.0e-4

endgroup R 68.0
endgroup H 1.008
endgroup U -1.008
endgroup ACTIVE 0.0
endgroup M_tr 100.12
endgroup CAP 40.0

polymer P active
polymer D dead

rate kd const 1.0e-3
rate ki const 1.0e3
rate kp const 500.0
rate ktc const 5.0e6
rate ktd const 5.0e6
rate ktr const 5.0e3
rate ktrm const 2.0e2
rate ktx const 5.0e3
rate kdp const 50.0

rxn I -> R + R kd
macro init R + M -> P ki
macro prop P + M -> P kp
macro term_c P + P -> D ktc
macro term_d P + P -> D + D ktd
macro transfer P + CTA -> D + Rcta ktr
macro transfer_m P + M -> D + P ktrm
macro term_x P + CAP -> D ktx
macro deprop P -> P + M kdp

every 1.0 save
every 1.0 save_chains
