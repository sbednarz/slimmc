desc "H15 control: initiation disabled"
param kmc_volume 1.0e-17
param t_end 1.0
param max_steps 100000
param seed 4151
param mass_model repeat_units
monomer M 0.010 100.0
species R 5.0e-5
endgroup R 68.0
endgroup ACTIVE 0.0
polymer P active
rate ki const 0.0
macro init R + M -> P ki
every 0.1 save
every 0.1 save_chains
