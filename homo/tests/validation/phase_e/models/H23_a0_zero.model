desc "H23 clean completion when total propensity is zero"
param kmc_volume 1.0e-17
param t_end 1.0
param max_steps 1000
param seed 2505
param mass_model repeat_units
monomer M 0.010 100.0
species R 0.0
endgroup R 68.0
endgroup ACTIVE 0.0
polymer P active
polymer D dead
rate ki const 1.0e8
macro init R + M -> P ki
every 0.25 save
