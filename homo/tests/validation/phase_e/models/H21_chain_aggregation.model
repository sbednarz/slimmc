desc "H21 identical chain aggregation"
param kmc_volume 1.0e-17
param t_end 0.05
param max_steps 200000
param seed 2502
param mass_model with_end_groups
monomer M 0.030 100.0
species R 3.0e-5
endgroup R 68.0
endgroup ACTIVE 2.0
polymer P active
polymer D dead
rate ki const 1.0e9
macro init R + M -> P ki
at 0.05 save
at 0.05 save_chains
