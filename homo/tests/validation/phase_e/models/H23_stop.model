desc "H23 clean completion by when stop"
param kmc_volume 1.0e-17
param t_end 10.0
param max_steps 1000000
param seed 2506
param mass_model repeat_units
param when_check_events 1
monomer M 0.020 100.0
species R 2.0e-5
endgroup R 68.0
endgroup ACTIVE 0.0
polymer P active
polymer D dead
rate ki const 1.0e8
rate kp const 1.0e5
macro init R + M -> P ki
macro prop P + M -> P kp
when X M > 0.02 stop
every 0.05 save
