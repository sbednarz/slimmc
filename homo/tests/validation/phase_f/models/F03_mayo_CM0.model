desc "F03 analytic: Mayo equation, transfer to monomer, C_M = 0.000"
param kmc_volume 2.0e-15
param t_end 10.0
param max_steps 20000000
param seed 6103
param mass_model repeat_units
monomer M 1.0 100.0
species I 1.0e-3
species R 0.0
endgroup R 68.0
endgroup ACTIVE 0.0
endgroup H 1.008
endgroup U -1.008
polymer P active
polymer D dead
rate kd const 1.0e-3
rate ki const 1.0e8
rate kp const 1.0e3
rate ktm const 0.0
rate ktd const 1.0e8
rxn I -> R + R kd 0.5
macro init R + M -> P ki
macro prop P + M -> P kp
macro transfer_m P + M -> D + P ktm
macro term_d P + P -> D + D ktd
every 2.0 save
at 10.0 save_chains
