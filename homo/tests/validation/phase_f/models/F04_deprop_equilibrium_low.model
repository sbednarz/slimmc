desc "F04 analytic: depropagation equilibrium approached from below, same [M]eq"
param kmc_volume 1.0e-16
param t_end 30.0
param max_steps 120000000
param seed 6107
param mass_model repeat_units
monomer M 0.300 100.0
species R 2.0e-4
polymer P active
polymer D dead
rate ki const 1.0e8
rate kp const 1.0e3
rate kdp const 0.0
macro init R + M -> P ki
macro prop P + M -> P kp
macro deprop P -> P + M kdp
at 7.00 set_k kdp 100.0
every 1.0 save
at 30.0 save_chains
