desc "H11 save and save_chains at same time coalesce into one logical snapshot"
param kmc_volume 1.0e-17
param temperature 298.15
param t_end 0.20
param max_steps 1000
param seed 1102
monomer M 0.0 100.0
species Q 0.1
species R 0.0
polymer P active
rate k const 0.0
rxn Q -> R k
at 0.10 save
at 0.10 save_chains
