desc "H01 dp_max: propagation stops at DP 4"
param kmc_volume 1.0e-17
param t_end 0.30
param max_steps 300000
param seed 2112
param mass_model repeat_units
param dp_max 4
monomer M 0.020 100.0
species R 2.0e-5
endgroup R 68.0
endgroup ACTIVE 0.0
polymer P active
polymer D dead
rate ki const 1.0e8
rate kp const 5.0e6
macro init R + M -> P ki
macro prop P + M -> P kp
every 0.02 save
every 0.02 save_chains
