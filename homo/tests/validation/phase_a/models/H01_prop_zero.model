desc "H01 control: initiation without propagation"
param kmc_volume 1.0e-17
param t_end 0.20
param max_steps 200000
param seed 2111
param mass_model repeat_units
monomer M 0.020 100.0
species R 2.0e-5
endgroup R 68.0
endgroup ACTIVE 0.0
polymer P active
polymer D dead
rate ki const 1.0e8
rate kp const 0.0
macro init R + M -> P ki
macro prop P + M -> P kp
every 0.02 save
every 0.02 save_chains
