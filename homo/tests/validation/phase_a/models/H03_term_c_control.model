desc "H03 control: no combination after build"
param kmc_volume 1.0e-17
param t_end 0.35
param max_steps 400000
param seed 2103
param mass_model repeat_units
monomer M 0.020 100.0
species R 4.0e-5
endgroup R 68.0
endgroup ACTIVE 0.0
polymer P active
polymer D dead
rate ki const 1.0e8
rate kp const 1.0e5
rate ktc const 0.0
macro init R + M -> P ki
macro prop P + M -> P kp
macro term_c P + P -> D ktc
at 0.15 set_k ki 0.0
at 0.15 set_k kp 0.0
every 0.025 save
every 0.025 save_chains
