desc "H02 integration: build chains then isolated depropagation"
param kmc_volume 1.0e-17
param t_end 0.40
param max_steps 400000
param seed 2102
param mass_model repeat_units
monomer M 0.020 100.0
species R 2.0e-5
endgroup R 68.0
endgroup ACTIVE 0.0
polymer P active
polymer D dead
rate ki const 1.0e8
rate kp const 2.0e5
rate kdp const 0.0
macro init R + M -> P ki
macro prop P + M -> P kp
macro deprop P -> P + M kdp
at 0.20 set_k ki 0.0
at 0.20 set_k kp 0.0
at 0.20 set_k kdp 25.0
every 0.02 save
every 0.02 save_chains
