desc "H08-H09 validation: competing channels and normalized SSA waiting times"
param kmc_volume 1.0e-17
param t_end 100.0
param max_steps 8000
param seed 3201
monomer M 0.0 100.0
species A 0.020
species B 0.0
species C 0.0
rate k1 const 100.0
rate k2 const 300.0
rxn A -> B k1
rxn A -> C k2
every 10.0 save
